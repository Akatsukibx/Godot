  "hpRegenPercent": 0.03,

  // คราฟต์: โอกาสสำเร็จตาม rarity ของของที่ได้ (ปกติ ดี หายาก ล้ำค่า ตำนาน)
  "craftSuccess": [1.0, 0.95, 0.8, 0.6, 0.4],

